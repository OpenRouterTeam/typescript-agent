{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh",
            "args": ["lint"],
            "asyncRewake": true,
            "statusMessage": "Linting…",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.sh",
            "args": ["typecheck"],
            "asyncRewake": true,
            "statusMessage": "Typechecking…",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
