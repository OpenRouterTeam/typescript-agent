{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "esm",
    "rootDir": "src",
    // Resolve deps via published exports, not the repo-wide "source" condition:
    // the optional peer "@modelcontextprotocol/client" (used by src/mcp) transitively
    // exposes a "source" condition pointing at raw .ts files (eventsource).
    "customConditions": []
  },
  "include": ["src"],
  "exclude": ["node_modules", "esm"]
}
