{
  "name": "typescript-agent-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:watch": "turbo run test:watch",
    "benchmark:memory:bundle": "pnpm build && pnpm dlx esbuild@0.28.1 benchmarks/agent-memory/cloudflare-worker.mjs --bundle --platform=browser --format=esm --target=es2022 --minify --tree-shaking=true --outfile=.turbo/agent-memory/cloudflare-worker.bundle.mjs --metafile=.turbo/agent-memory/cloudflare-worker.meta.json",
    "benchmark:memory:sdk-bundle": "pnpm build && pnpm dlx esbuild@0.28.1 benchmarks/agent-memory/cloudflare-sdk-worker.mjs --bundle --platform=browser --format=esm --target=es2022 --minify --tree-shaking=true --outfile=.turbo/agent-memory/cloudflare-sdk-worker.bundle.mjs --metafile=.turbo/agent-memory/cloudflare-sdk-worker.meta.json",
    "benchmark:memory:bundle-sizes": "pnpm benchmark:memory:bundle && pnpm benchmark:memory:sdk-bundle && node benchmarks/agent-memory/report-bundle-sizes.mjs .turbo/agent-memory/cloudflare-worker.bundle.mjs .turbo/agent-memory/cloudflare-sdk-worker.bundle.mjs",
    "benchmark:memory:imports": "pnpm benchmark:memory:bundle && pnpm benchmark:memory:sdk-bundle && node benchmarks/agent-memory/run-import-matrix.mjs empty=benchmarks/agent-memory/empty-worker.mjs sdk=.turbo/agent-memory/cloudflare-sdk-worker.bundle.mjs agent=.turbo/agent-memory/cloudflare-worker.bundle.mjs",
    "benchmark:memory:broadcaster": "pnpm build && node benchmarks/agent-memory/run-broadcaster-peak-matrix.mjs --runs=20 --events=50000",
    "benchmark:memory:reusable": "pnpm build && node benchmarks/agent-memory/run-reusable-peak-matrix.mjs --runs=20 --events=50000",
    "benchmark:memory:synthetic": "node --expose-gc --max-old-space-size=128 --max-semi-space-size=8 benchmarks/agent-memory/benchmark.mjs --mode synthetic",
    "benchmark:memory:live": "pnpm benchmark:memory:bundle && node --expose-gc --max-old-space-size=128 --max-semi-space-size=8 benchmarks/agent-memory/benchmark.mjs --mode live --bundle .turbo/agent-memory/cloudflare-worker.bundle.mjs",
    "lint": "turbo run lint",
    "lint:fix": "biome check --write packages/*/src packages/*/tests",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@types/node": "^22.13.12",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^16.4.7",
    "husky": "^9.1.7",
    "turbo": "2.9.6",
    "typescript": "~5.8.3",
    "vitest": "^4.1.5"
  }
}
